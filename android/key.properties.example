# Copy this file to `android/key.properties` and fill in your release signing values.
# `android/key.properties` is gitignored and must NEVER be committed.
# `storeFile` is resolved relative to the `android/app/` directory.
storeFile=poker.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
